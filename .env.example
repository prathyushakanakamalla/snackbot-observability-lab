# Copy this file to ".env" and fill in your key from https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here

# Optional overrides (defaults shown)
GROQ_MODEL=llama-3.3-70b-versatile
TEMPERATURE=0.2
TOP_K=4
CHUNK_SIZE=800
CHUNK_OVERLAP=150

# Phase 1 — tracing
TRACING=full                       # off | auto | full
PHOENIX_ENDPOINT=http://localhost:6006
PHOENIX_PROJECT=snackbot

# Phase 2 — evaluation
JUDGE_MODEL=openai/gpt-oss-120b    # or openai/gpt-oss-20b (faster); must support JSON-schema output on Groq
